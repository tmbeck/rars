+fn write_producer_probe(
+    out: &mut dyn Write,
+    target: ArchiveVersion,
+    header_password: Option<&[u8]>,
+) -> Result<()> {
+    if !matches!(target, ArchiveVersion::Rar30 | ArchiveVersion::Rar40) {
+        return Ok(());
+    }
+    let data = concat!("rars/", env!("CARGO_PKG_VERSION"), "\nmarker-schema=1\n").as_bytes();
+    let mut header = Vec::new();
+    write_file_header(
+        &mut header,
+        &FileRecord {
+            head_type: NEWSUB_HEAD,
+            name: b"RARS",
+            unpacked_size: data.len(),
+            file_crc: crc32(data),
+            packed_size: data.len(),
+            file_time: 0,
+            file_attr: 0,
+            host_os: 0,
+            target,
+            method: 0x30,
+            dictionary_flags: 0,
+            flags: 0x4000,
+            salt: None,
+            extra: &[],
+        },
+    )?;
+    if let Some(password) = header_password {
+        write_encrypted_header(out, &header, password)?;
+    } else {
+        out.write_all(&header)?;
+    }
+    out.write_all(data)?;
+    Ok(())
+}
