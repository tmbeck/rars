+// Investigation prototype: archive-level service, no file dependency or QO entry.
+fn producer_probe<'a>(
+    header_keys: Option<&HeaderEncryptionKeys>,
+    resources: &WriterResources,
+) -> Result<PreparedBlock<'a>> {
+    let data = concat!("rars/", env!("CARGO_PKG_VERSION"), "\nmarker-schema=1\n").as_bytes();
+    let specific = stored_file_specific(
+        b"RARS",
+        data.len() as u64,
+        crate::crc32::crc32(data),
+        0,
+        None,
+        0,
+        resources,
+    )?;
+    let header = prepared_header_image(
+        HEAD_SERVICE,
+        HFL_DATA | 0x0004,
+        Some(data.len() as u64),
+        &specific,
+        &[],
+        header_keys,
+        resources,
+    )?;
+    Ok(PreparedBlock {
+        header,
+        payload: Payload::Borrowed(data),
+        payload_len: data.len() as u64,
+        quick_open_cached: false,
+        entry_index: None,
+    })
+}
