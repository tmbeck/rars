+//! The existing binary-tree search with compact child links. Candidate order,
+//! tree reattachment, visit limits and caller-controlled insertion schedules
+//! follow `TreeMatchFinder`; only link storage and prefix extension differ.
+
+use super::compact_links::CompactLinks;
+use super::match_finder::NO_POSITION;
+use super::workspace::{Allowance, Budget, Buffer};
+use super::Result;
+
+const NO_LINK: u32 = u32::MAX;
+
+fn resolve(newest: usize, link: u32) -> usize {
+    if link == NO_LINK {
+        return NO_POSITION;
+    }
+    newest - (newest as u32).wrapping_sub(link) as usize
+}
+
+fn comparison_start(pos: usize, len0: usize, len1: usize) -> usize {
+    // After head positions wrap, an old head can alias a skipped tree node.
+    // Its inherited ordering no longer proves a common prefix. Verify every
+    // candidate from byte zero; discovery quality may differ after the wrap.
+    if pos > u32::MAX as usize {
+        0
+    } else {
+        len0.min(len1)
+    }
+}
+
+#[derive(Debug)]
+pub(crate) struct CompactTreeMatchFinder<B: Budget = Allowance> {
+    head: Buffer<u32, B>,
+    son: CompactLinks<B>,
+    mask: usize,
+}
+
+impl<B: Budget> CompactTreeMatchFinder<B> {
+    const HASH_BITS: u32 = 17;
+    const MIN_MATCH: usize = 4;
+
+    pub(crate) fn with_allowance(window: usize, allowance: &B) -> Result<Self> {
+        let window = window
+            .max(1)
+            .checked_next_power_of_two()
+            .ok_or(super::Error::InvalidData("finder window overflows"))?;
+        Ok(Self {
+            head: Buffer::filled(1 << Self::HASH_BITS, NO_LINK, allowance)?,
+            son: CompactLinks::with_allowance(
+                window
+                    .checked_mul(2)
+                    .ok_or(super::Error::InvalidData("finder window overflows"))?,
+                allowance,
+            )?,
+            mask: window - 1,
+        })
+    }
+
+    pub(crate) fn allowance(&self) -> B {
+        self.son.allowance()
+    }
+
+    /// Finds and inserts exactly the wide tree's candidates. On allocation
+    /// refusal, discard this finder: output or child reattachment may already
+    /// have changed before an overflow-link or output allocation was refused.
+    pub(crate) fn matches(
+        &mut self,
+        input: &[u8],
+        pos: usize,
+        len_limit: usize,
+        max_distance: usize,
+        cut: usize,
+        out: &mut Buffer<(u32, u32), B>,
+    ) -> std::result::Result<(), B::Failure> {
+        debug_assert!(len_limit >= Self::MIN_MATCH && pos + len_limit <= input.len());
+        let value =
+            u32::from_le_bytes([input[pos], input[pos + 1], input[pos + 2], input[pos + 3]]);
+        let hash = (value.wrapping_mul(0x9E37_79B1) >> (32 - Self::HASH_BITS)) as usize;
+        let mut current = resolve(pos, self.head[hash]);
+        self.head[hash] = pos as u32;
+        let mut ptr0 = ((pos & self.mask) << 1) + 1;
+        let mut ptr1 = (pos & self.mask) << 1;
+        // Each attachment slot belongs to its node, which can differ from the
+        // newest query. The compact delta must use that exact owner position.
+        let mut ptr0_owner = pos;
+        let mut ptr1_owner = pos;
+        let mut len0 = 0usize;
+        let mut len1 = 0usize;
+        let mut longest = Self::MIN_MATCH - 1;
+        let mut budget = cut;
+        let mut floor = pos;
+        loop {
+            if current >= floor || pos - current > self.mask || budget == 0 {
+                self.son.set(ptr0, ptr0_owner, NO_LINK)?;
+                self.son.set(ptr1, ptr1_owner, NO_LINK)?;
+                return Ok(());
+            }
+            budget -= 1;
+            floor = current;
+            let pair = (current & self.mask) << 1;
+            let mut len = comparison_start(pos, len0, len1);
+            if input[current + len] == input[pos + len] {
+                len += 1;
+                // The guarded byte and proven prefix are already equal. The
+                // same distance at the shifted position extends only the
+                // remaining suffix, including overlapping matches.
+                len += super::fast::match_length(input, pos + len, pos - current, len_limit - len);
+                if len > longest {
+                    if pos - current <= max_distance {
+                        out.push((len as u32, (pos - current) as u32))?;
+                    }
+                    longest = len;
+                    if len == len_limit {
+                        let child = self.son.get(pair, current);
+                        self.son.set(ptr1, ptr1_owner, child)?;
+                        let child = self.son.get(pair + 1, current);
+                        self.son.set(ptr0, ptr0_owner, child)?;
+                        return Ok(());
+                    }
+                }
+            }
+            if input[current + len] < input[pos + len] {
+                self.son.set(ptr1, ptr1_owner, current as u32)?;
+                ptr1 = pair + 1;
+                ptr1_owner = current;
+                len1 = len;
+                current = resolve(pos, self.son.get(ptr1, ptr1_owner));
+            } else {
+                self.son.set(ptr0, ptr0_owner, current as u32)?;
+                ptr0 = pair;
+                ptr0_owner = current;
+                len0 = len;
+                current = resolve(pos, self.son.get(ptr0, ptr0_owner));
+            }
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::codec::match_finder::TreeMatchFinder;
+
+    fn compare_runs(input: &[u8], window: usize, cut: usize, cap: usize, skip_nice: bool) {
+        let allowance = Allowance::default();
+        let mut wide = TreeMatchFinder::with_allowance(window, &allowance).unwrap();
+        let mut compact = CompactTreeMatchFinder::with_allowance(window, &allowance).unwrap();
+        let mut wide_runs = Buffer::new(&allowance);
+        let mut compact_runs = Buffer::new(&allowance);
+        let mut committed_through = 0;
+        for pos in 0..input.len().saturating_sub(3) {
+            if pos < committed_through {
+                continue;
+            }
+            let limit = cap.min(input.len() - pos);
+            let max_distance = pos.min(window);
+            wide_runs.clear();
+            compact_runs.clear();
+            wide.matches(input, pos, limit, max_distance, cut, &mut wide_runs)
+                .unwrap();
+            compact
+                .matches(input, pos, limit, max_distance, cut, &mut compact_runs)
+                .unwrap();
+            assert_eq!(
+                &wide_runs[..],
+                &compact_runs[..],
+                "position {pos}, window {window}, cut {cut}, cap {cap}"
+            );
+            if skip_nice {
+                if let Some(&(length, distance)) = wide_runs.last() {
+                    if length >= 512 {
+                        let reach = super::super::fast::match_length(
+                            input,
+                            pos,
+                            distance as usize,
+                            (input.len() - pos).min(4096),
+                        );
+                        committed_through = pos + reach;
+                    }
+                }
+            }
+        }
+    }
+
+    #[test]
+    fn compact_tree_matches_wide_on_small_inputs_and_reused_slots() {
+        let inputs = [
+            b"abcdabcdabcdabcdabcdabcd".as_slice(),
+            b"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
+            b"abracadabra!abracadabra?abracadabra!abracadabra?",
+            b"abcdXabcdYabcdZabcdWabcdXabcdYabcdZabcdW",
+        ];
+        for input in inputs {
+            for (window, cut, cap) in [(1, 0, 4), (8, 1, 8), (16, 8, 16), (64, 128, 64)] {
+                compare_runs(input, window, cut, cap, false);
+            }
+        }
+    }
+
+    #[test]
+    fn compact_tree_matches_wide_on_exhaustive_eight_byte_binary_inputs() {
+        for bits in 0..256u16 {
+            let input: Vec<_> = (0..8).map(|offset| ((bits >> offset) & 1) as u8).collect();
+            compare_runs(&input, 8, 8, 8, false);
+        }
+    }
+
+    #[test]
+    fn compact_tree_matches_wide_on_seeded_distant_and_long_repeats() {
+        let mut input = vec![0u8; 2 * 65536 + 2048];
+        let mut seed = 0xB503_1CE4_7DA2_698Fu64;
+        for byte in &mut input {
+            seed ^= seed << 13;
+            seed ^= seed >> 7;
+            seed ^= seed << 17;
+            *byte = (seed >> 24) as u8;
+        }
+        for (position, suffix) in [(17, 0), (66017, 64), (132017, 128)] {
+            input[position..position + 4].copy_from_slice(b"ABCD");
+            input[position + 4] = suffix;
+        }
+        input.copy_within(100..4196, 80000);
+        compare_runs(&input, 256 * 1024, 128, 128, false);
+        compare_runs(&input, 256 * 1024, 128, 512, true);
+    }
+
+    #[test]
+    #[cfg(target_pointer_width = "64")]
+    fn compact_head_resolution_preserves_full_positions_across_u32_wrap() {
+        let newest = (1usize << 32) + 16;
+        assert_eq!(resolve(newest, 16), newest);
+        assert_eq!(resolve(newest, 0), 1usize << 32);
+        assert_eq!(resolve(newest, u32::MAX - 1), (1usize << 32) - 2);
+        assert_eq!(resolve(newest, NO_LINK), NO_POSITION);
+    }
+
+    #[test]
+    fn compact_tree_comparison_reuses_prefix_only_before_head_wrap() {
+        assert_eq!(comparison_start(0, 7, 11), 7);
+        assert_eq!(comparison_start(u32::MAX as usize, 11, 7), 7);
+        #[cfg(target_pointer_width = "64")]
+        {
+            assert_eq!(comparison_start(1usize << 32, 7, 11), 0);
+            assert_eq!(comparison_start((1usize << 32) + 19, 11, 7), 0);
+        }
+    }
+}
