index 0000000000000000000000000000000000000000..4a75147b63b248f942a3e447b87cf9b7fe42e06e
--- /dev/null
+++ b/crates/rars/src/codec/compact_links.rs
@@ -0,0 +1,366 @@
+//! Exact compact storage for tree/chain links, owned by their ring positions.
+//!
+//! Short links are backward deltas. Other codes directly select an exact u32
+//! link in their owner's page, avoiding a hash lookup or tree-link eviction.
+//! Callers must supply the current owner of a ring slot, never an expired owner.
+
+use super::workspace::{Allowance, Budget, Buffer};
+use super::Result;
+
+const NO_LINK: u32 = u32::MAX;
+const PAGE_BITS: usize = 12;
+const PAGE_SIZE: usize = 1 << PAGE_BITS;
+const OVERFLOW_BASE: u16 = 61_440;
+const NO_FREE: u16 = u16::MAX;
+
+#[derive(Debug)]
+struct Page<B: Budget> {
+    links: Buffer<u32, B>,
+    free_head: u16,
+}
+
+#[derive(Debug)]
+pub(crate) struct CompactLinks<B: Budget = Allowance> {
+    codes: Buffer<u16, B>,
+    pages: Buffer<Page<B>, B>,
+}
+
+impl<B: Budget> CompactLinks<B> {
+    pub(crate) fn with_allowance(slots: usize, allowance: &B) -> Result<Self> {
+        let codes = Buffer::filled(slots, 0, allowance)?;
+        let page_count = slots.div_ceil(PAGE_SIZE);
+        let mut pages = Buffer::with_capacity(page_count, allowance)?;
+        for _ in 0..page_count {
+            pages.push_admitted(Page {
+                links: Buffer::new(allowance),
+                free_head: NO_FREE,
+            });
+        }
+        Ok(Self { codes, pages })
+    }
+
+    pub(crate) fn allowance(&self) -> B {
+        self.codes.allowance()
+    }
+
+    #[inline]
+    pub(crate) fn get(&self, slot: usize, owner: usize) -> u32 {
+        let code = self.codes[slot];
+        match code {
+            0 => NO_LINK,
+            OVERFLOW_BASE.. => self.pages[slot >> PAGE_BITS].links[(code - OVERFLOW_BASE) as usize],
+            delta => (owner as u32).wrapping_sub(u32::from(delta)),
+        }
+    }
+
+    #[inline]
+    pub(crate) fn set(
+        &mut self,
+        slot: usize,
+        owner: usize,
+        link: u32,
+    ) -> std::result::Result<(), B::Failure> {
+        let previous = self.codes[slot];
+        let delta = (owner as u32).wrapping_sub(link);
+        let short = if link == NO_LINK {
+            Some(0)
+        } else if (1..u32::from(OVERFLOW_BASE)).contains(&delta) {
+            Some(delta as u16)
+        } else {
+            None
+        };
+        if let Some(code) = short {
+            if previous >= OVERFLOW_BASE {
+                let page = &mut self.pages[slot >> PAGE_BITS];
+                let index = (previous - OVERFLOW_BASE) as usize;
+                // Only released cells contain free-list pointers. An active
+                // cell always retains the caller's original raw link.
+                page.links[index] = u32::from(page.free_head);
+                page.free_head = index as u16;
+            }
+            self.codes[slot] = code;
+            return Ok(());
+        }
+        let page = &mut self.pages[slot >> PAGE_BITS];
+        if previous >= OVERFLOW_BASE {
+            page.links[(previous - OVERFLOW_BASE) as usize] = link;
+            return Ok(());
+        }
+        let index = if page.free_head != NO_FREE {
+            let index = page.free_head as usize;
+            page.free_head = page.links[index] as u16;
+            page.links[index] = link;
+            index
+        } else {
+            let index = page.links.len();
+            // A page has at most one active cell per owning code slot. A full
+            // pool with this slot still short would violate that ownership.
+            assert!(index < PAGE_SIZE, "overflow page has no reusable cell");
+            page.links.push(link)?;
+            index
+        };
+        // Publish the code only after any fallible pool allocation succeeded.
+        self.codes[slot] = OVERFLOW_BASE + index as u16;
+        Ok(())
+    }
+}
