@@ -0,0 +1,434 @@
+//! The ordinary four-byte hash chain with an exact compact link representation.
+//!
+//! Hashing, head entries and candidate order match `MatchFinder<4>`. Only the
+//! ring's previous links use `CompactLinks`; uncommon links retain their exact
+//! low 32 bits through that backend's charged overflow storage. A refused
+//! insertion is returned before publishing its head or advancing `newest`.
+
+use super::compact_links::CompactLinks;
+use super::match_finder::NO_POSITION;
+use super::workspace::{Allowance, Budget, Buffer};
+use super::Result;
+
+const HASH_BITS: u32 = 17;
+const NO_LINK: u32 = u32::MAX;
+
+fn resolve(newest: usize, link: u32) -> usize {
+    if link == NO_LINK {
+        NO_POSITION
+    } else {
+        newest - (newest as u32).wrapping_sub(link) as usize
+    }
+}
+
+#[derive(Debug)]
+pub(crate) struct CompactMatchFinder<B: Budget = Allowance> {
+    head: Buffer<u32, B>,
+    prev: CompactLinks<B>,
+    mask: usize,
+    newest: usize,
+}
+
+impl<B: Budget> CompactMatchFinder<B> {
+    pub(crate) fn with_allowance(window: usize, allowance: &B) -> Result<Self> {
+        let window = window
+            .max(1)
+            .checked_next_power_of_two()
+            .ok_or(super::Error::InvalidData("finder window overflows"))?;
+        Ok(Self {
+            head: Buffer::filled(1 << HASH_BITS, NO_LINK, allowance)?,
+            prev: CompactLinks::with_allowance(window, allowance)?,
+            mask: window - 1,
+            newest: 0,
+        })
+    }
+
+    pub(crate) fn allowance(&self) -> B {
+        self.head.allowance()
+    }
+
+    #[inline]
+    fn hash(input: &[u8], pos: usize) -> usize {
+        let value =
+            u32::from_le_bytes([input[pos], input[pos + 1], input[pos + 2], input[pos + 3]]);
+        (value.wrapping_mul(0x9E37_79B1) >> (32 - HASH_BITS)) as usize
+    }
+
+    #[inline]
+    fn record(&mut self, hash: usize, pos: usize) -> std::result::Result<(), B::Failure> {
+        self.prev.set(pos & self.mask, pos, self.head[hash])?;
+        self.head[hash] = pos as u32;
+        self.newest = self.newest.max(pos);
+        Ok(())
+    }
+
+    /// Records a position; a tail with fewer than four bytes is ignored.
+    ///
+    /// Unlike the wide chain, a compact insertion can need overflow storage.
+    /// Callers must propagate a refusal and discard the failed finder rather
+    /// than silently omitting a candidate.
+    #[inline]
+    pub(crate) fn insert(
+        &mut self,
+        input: &[u8],
+        pos: usize,
+    ) -> std::result::Result<(), B::Failure> {
+        if pos.checked_add(4).is_some_and(|end| end <= input.len()) {
+            self.record(Self::hash(input, pos), pos)?;
+        }
+        Ok(())
+    }
+
+    /// Insert and return the first older candidate exactly as an ordinary
+    /// insert/first/previous sequence would, without hashing the query twice.
+    #[inline]
+    pub(crate) fn insert_and_first(
+        &mut self,
+        input: &[u8],
+        pos: usize,
+    ) -> std::result::Result<usize, B::Failure> {
+        debug_assert!(pos + 4 <= input.len());
+        self.record_first(Self::hash(input, pos), pos)
+    }
+
+    #[inline]
+    fn record_first(&mut self, hash: usize, pos: usize) -> std::result::Result<usize, B::Failure> {
+        let previous = self.head[hash];
+        self.record(hash, pos)?;
+        // A sentinel-valued current head ends the ordinary walk before it
+        // reaches the previous link, even when that link is populated.
+        if pos as u32 == NO_LINK {
+            return Ok(NO_POSITION);
+        }
+        let older = resolve(self.newest, previous);
+        Ok(if older < pos { older } else { NO_POSITION })
+    }
+
+    /// Requires at least four readable bytes, like the ordinary finder.
+    #[inline]
+    pub(crate) fn first(&self, input: &[u8], pos: usize) -> usize {
+        resolve(self.newest, self.head[Self::hash(input, pos)])
+    }
+
+    #[inline]
+    pub(crate) fn previous(&self, candidate: usize) -> usize {
+        // A compact slot decodes against its owning position. Once that owner
+        // expires, the slot may have been reused and must not be interpreted
+        // with the old owner. Encoder walks already check dictionary distance
+        // before following a link; this explicit guard also makes stale reads
+        // terminate instead of reconstructing a link from the wrong owner.
+        if candidate > self.newest || self.newest - candidate > self.mask {
+            return NO_POSITION;
+        }
+        let older = resolve(self.newest, self.prev.get(candidate & self.mask, candidate));
+        if older >= candidate {
+            NO_POSITION
+        } else {
+            older
+        }
+    }
+
+    /// Replay the ordinary chain's visit budget and improving match frontier.
+    /// Hash collisions still consume visits, but cannot supply a legal four-
+    /// byte match. Confirm the whole prefix once before extending its suffix.
+    #[allow(clippy::too_many_arguments)]
+    pub(crate) fn collect_improving(
+        &self,
+        input: &[u8],
+        pos: usize,
+        first: usize,
+        max_length: usize,
+        max_distance: usize,
+        cut: usize,
+        nice: usize,
+        out: &mut Buffer<(u32, u32), B>,
+    ) -> std::result::Result<(), B::Failure> {
+        debug_assert!(max_length >= 4 && pos + max_length <= input.len());
+        if cut == 0 {
+            return Ok(());
+        }
+        let prefix = u32::from_le_bytes(input[pos..pos + 4].try_into().unwrap());
+        let mut longest = 0;
+        let mut checked = 0;
+        let mut candidate = first;
+        while candidate != NO_POSITION && longest < max_length && longest < nice {
+            if candidate >= pos {
+                candidate = self.previous(candidate);
+                continue;
+            }
+            let distance = pos - candidate;
+            if distance > max_distance {
+                break;
+            }
+            checked += 1;
+            let difference =
+                prefix ^ u32::from_le_bytes(input[candidate..candidate + 4].try_into().unwrap());
+            let length = if difference != 0 {
+                // Preserve even the ordinary collector's sub-four-byte runs,
+                // including their output allocation/refusal behavior.
+                (difference.trailing_zeros() / 8) as usize
+            } else if longest < 4 || input[candidate + longest] == input[pos + longest] {
+                4 + super::fast::match_length(input, pos + 4, distance, max_length - 4)
+            } else {
+                0
+            };
+            if length > longest {
+                out.push((length as u32, distance as u32))?;
+                longest = length;
+            }
+            if checked >= cut {
+                break;
+            }
+            candidate = self.previous(candidate);
+        }
+        Ok(())
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::codec::match_finder::MatchFinder;
+    use crate::codec::workspace::RefusingBudget;
+
+    fn fixture(length: usize) -> Vec<u8> {
+        let mut state = 0x7a59_1234_aa55_0123u64;
+        let mut input = Vec::with_capacity(length);
+        for _ in 0..length {
+            state ^= state << 13;
+            state ^= state >> 7;
+            state ^= state << 17;
+            input.push(state as u8);
+        }
+        for pos in (0..length.saturating_sub(32)).step_by(997) {
+            input[pos..pos + 16].copy_from_slice(b"repeated-prefix!");
+        }
+        input
+    }
+
+    #[test]
+    fn fused_prefix_search_matches_every_wide_improving_run() {
+        let random = fixture(24 * 1024);
+        let patterned = b"abcdabcdXYZabcdabcdXYQ----abcdabcdXYZabcdabcdXYR".repeat(48);
+        for input in [&random[..], &patterned[..]] {
+            for (window, cut, cap) in [(64, 0, 4), (4096, 1, 64), (65536, 128, 513)] {
+                let allowance = Allowance::default();
+                let mut compact = CompactMatchFinder::with_allowance(window, &allowance).unwrap();
+                let mut wide = MatchFinder::<4>::new(window);
+                let mut expected = Vec::new();
+                let mut actual = Buffer::new(&allowance);
+                for pos in 0..input.len() - 3 {
+                    let first = compact.insert_and_first(input, pos).unwrap();
+                    wide.insert(input, pos);
+                    let max_length = cap.min(input.len() - pos);
+                    let max_distance = pos.min(window);
+                    expected.clear();
+                    actual.clear();
+                    if cut != 0 {
+                        let mut candidate = wide.first(input, pos);
+                        let mut longest = 0;
+                        let mut checked = 0;
+                        while candidate != NO_POSITION && longest < max_length && longest < 512 {
+                            if candidate >= pos {
+                                candidate = wide.previous(candidate);
+                                continue;
+                            }
+                            let distance = pos - candidate;
+                            if distance > max_distance {
+                                break;
+                            }
+                            checked += 1;
+                            if input[candidate + longest] == input[pos + longest] {
+                                let length = super::super::fast::match_length(
+                                    input, pos, distance, max_length,
+                                );
+                                if length > longest {
+                                    expected.push((length as u32, distance as u32));
+                                    longest = length;
+                                }
+                            }
+                            if checked >= cut {
+                                break;
+                            }
+                            candidate = wide.previous(candidate);
+                        }
+                    }
+                    compact
+                        .collect_improving(
+                            input,
+                            pos,
+                            first,
+                            max_length,
+                            max_distance,
+                            cut,
+                            512,
+                            &mut actual,
+                        )
+                        .unwrap();
+                    assert_eq!(
+                        &actual[..],
+                        &expected[..],
+                        "position {pos}, window {window}, cut {cut}, cap {cap}"
+                    );
+                }
+            }
+        }
+    }
+
+    #[test]
+    #[cfg(target_pointer_width = "64")]
+    fn fused_insertion_preserves_the_low_word_sentinel_and_wrap() {
+        let wrap = 1usize << 32;
+        let allowance = Allowance::default();
+        let mut fused = CompactMatchFinder::with_allowance(1 << 18, &allowance).unwrap();
+        let mut ordinary = CompactMatchFinder::with_allowance(1 << 18, &allowance).unwrap();
+        for pos in [wrap - 5, wrap - 1, wrap, wrap + 70000, wrap + 70004] {
+            let actual = fused.record_first(0, pos).unwrap();
+            ordinary.record(0, pos).unwrap();
+            let head = resolve(ordinary.newest, ordinary.head[0]);
+            let expected = if head == pos {
+                ordinary.previous(head)
+            } else {
+                head
+            };
+            assert_eq!(actual, expected, "position {pos}");
+        }
+    }
+
+    #[test]
+    fn legal_chains_match_the_wide_finder_with_sparse_insertions_and_slot_reuse() {
+        let input = fixture(160 * 1024);
+        for window in [1, 8, 64, 4096, 65536, 131072] {
+            let mut compact = CompactMatchFinder::with_allowance(window, &Allowance::default())
+                .expect("unlimited compact finder");
+            let mut wide = MatchFinder::<4>::new(window);
+            for pos in 0..input.len() - 3 {
+                assert_eq!(compact.first(&input, pos), wide.first(&input, pos));
+                // Seed history densely and then exercise skipped source ranges.
+                if pos < 1024 || pos % 19 != 0 {
+                    compact.insert(&input, pos).unwrap();
+                    wide.insert(&input, pos);
+                }
+                if pos % 127 != 0 {
+                    continue;
+                }
+                let mut actual = compact.first(&input, pos);
+                let mut expected = wide.first(&input, pos);
+                for _ in 0..32 {
+                    assert_eq!(actual, expected);
+                    if expected == NO_POSITION || compact.newest - expected > compact.mask {
+                        break;
+                    }
+                    actual = compact.previous(actual);
+                    expected = wide.previous(expected);
+                }
+            }
+        }
+    }
+
+    #[test]
+    fn shared_prefix_candidates_keep_nearest_to_farthest_order() {
+        let input = b"abcdabcdabcdabcd";
+        let mut finder = CompactMatchFinder::with_allowance(64, &Allowance::default()).unwrap();
+        for pos in [0, 4, 8] {
+            finder.insert(input, pos).unwrap();
+        }
+        let mut candidate = finder.first(input, 12);
+        let mut visited = Vec::new();
+        while candidate != NO_POSITION {
+            visited.push(candidate);
+            candidate = finder.previous(candidate);
+        }
+        assert_eq!(visited, [8, 4, 0]);
+    }
+
+    #[test]
+    fn short_tails_do_not_change_heads_or_newest_and_expired_owners_stop() {
+        let input = b"abcdabcd";
+        let mut finder = CompactMatchFinder::with_allowance(4, &Allowance::default()).unwrap();
+        finder.insert(input, 0).unwrap();
+        finder.insert(input, 4).unwrap();
+        for pos in 5..=input.len() {
+            finder.insert(input, pos).unwrap();
+        }
+        finder.insert(input, usize::MAX).unwrap();
+        assert_eq!(finder.first(input, 0), 4);
+        assert_eq!(finder.newest, 4);
+        assert_eq!(finder.previous(0), NO_POSITION);
+        assert_eq!(finder.previous(usize::MAX), NO_POSITION);
+        assert_eq!(finder.previous(4), 0);
+    }
+
+    #[test]
+    #[cfg(target_pointer_width = "64")]
+    fn low_word_wrap_sentinel_and_long_links_match_a_wide_link_oracle() {
+        let window = 1 << 18;
+        let wrap = 1usize << 32;
+        let input = b"abcd";
+        let hash = CompactMatchFinder::<Allowance>::hash(input, 0);
+        let mut finder = CompactMatchFinder::with_allowance(window, &Allowance::default()).unwrap();
+        let mut head = NO_LINK;
+        let mut prev = vec![0u32; window];
+        let mut newest = 0usize;
+        for pos in [
+            wrap - 4,
+            wrap - 3,
+            wrap - 1,
+            wrap,
+            wrap + 70000,
+            wrap + 70004,
+        ] {
+            prev[pos & (window - 1)] = head;
+            head = pos as u32;
+            newest = newest.max(pos);
+            finder.record(hash, pos).unwrap();
+            let read = |raw: u32| {
+                if raw == NO_LINK {
+                    NO_POSITION
+                } else {
+                    newest - (newest as u32).wrapping_sub(raw) as usize
+                }
+            };
+            let mut expected = read(head);
+            let mut actual = finder.first(input, 0);
+            for _ in 0..8 {
+                assert_eq!(actual, expected);
+                if expected == NO_POSITION {
+                    break;
+                }
+                let older = read(prev[expected & (window - 1)]);
+                expected = if older >= expected {
+                    NO_POSITION
+                } else {
+                    older
+                };
+                actual = finder.previous(actual);
+            }
+        }
+    }
+
+    #[test]
+    fn overflow_refusal_propagates_without_publishing_a_new_head() {
+        let probe = RefusingBudget::new(usize::MAX);
+        let finder = CompactMatchFinder::with_allowance(131072, &probe).unwrap();
+        let constructor_attempts = probe.attempts();
+        drop(finder);
+        assert_eq!(probe.used(), 0);
+        for fail_at in 0..constructor_attempts {
+            let budget = RefusingBudget::new(fail_at);
+            assert!(CompactMatchFinder::with_allowance(131072, &budget).is_err());
+            assert_eq!(budget.used(), 0);
+        }
+        let budget = RefusingBudget::new(constructor_attempts);
+        let mut finder = CompactMatchFinder::with_allowance(131072, &budget).unwrap();
+        let hash = CompactMatchFinder::<Allowance>::hash(b"abcd", 0);
+        finder.record(hash, 1).unwrap();
+        let error = finder.record(hash, 100000).unwrap_err();
+        assert_eq!(error, super::super::Error::Cancelled);
+        assert_eq!(finder.head[hash], 1);
+        assert_eq!(finder.newest, 1);
+        assert_eq!(finder.previous(1), NO_POSITION);
+        drop(finder);
+        assert_eq!(budget.used(), 0);
+    }
+}
